# Cle API Mistral (free tier sur https://console.mistral.ai/)
MISTRAL_API_KEY=

# Modele Mistral a utiliser (gratuit : mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# Marque active par defaut
DEFAULT_BRAND=lelins

# Hote / port du serveur
APP_HOST=127.0.0.1
APP_PORT=8000

# Studio visuel (optionnel) : generation d'image + essayage virtuel.
# Laisse IMAGE_PROVIDER vide pour desactiver. Fournisseur de reference : fal.ai
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_GEN_MODEL=fal-ai/flux/schnell
IMAGE_TRYON_MODEL=fal-ai/fashn/tryon
